# Copy this file to .env and fill in real values. .env is git-ignored; this file is not.

# Superuser of the compose PostgreSQL — used only to create the app role on first start
POSTGRES_PASSWORD=change-me

# The app's own role (timetrack_app), a non-superuser that owns only the timetrack database
DB_PASSWORD=change-me

# HMAC key for signing JWTs — at least 64 characters
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-64-characters-000000

# Password of the manager the dev profile seeds on first start
ADMIN_PASSWORD=change-me
